[group: 'modules']
mod demo "demo/justfile"

# <sdk-dir>:<library-basename> for each shipped SDK (dir name ≠ lib name for
# prowrist). Used by the public check/install recipes below. Defined here in the
# header so the publish filter keeps it (it only preserves header assignments a
# kept recipe references, and drops the dev-only crate paths above).
SDK_LIBS := "prohand_sdk:libprohand_client_sdk proglove_sdk:libproglove_client_sdk prowrist_sdk:libprowristcam_client_sdk"

default:
    @echo "════════════════════════════════════════════════════════════════"
    @echo "Proception SDK"
    @echo "════════════════════════════════════════════════════════════════"
    @just --list
    @echo "────────────────────────────────────────────────────────────────"
    @echo "Common commands — prefix with 'just' (here) or 'just sdk' (from repo root):"
    @echo "  check              verify the libraries for this platform"
    @echo "  install [prefix]   install C/C++ libs + headers (default /usr/local)"
    @echo "  install-python     install the Python SDKs into your env (uv, else pip)"
    @echo "  demo ...           runnable examples (Python & C++)"
    @echo "════════════════════════════════════════════════════════════════"

# Verify the compiled library for THIS OS/arch is present for every SDK.
check:
    #!/usr/bin/env bash
    set -euo pipefail
    os="$(uname -s)"; arch="$(uname -m)"
    if [[ "$os" == "Darwin" ]]; then suffix=".dylib"
    elif [[ "$os" == "Linux" && ( "$arch" == "aarch64" || "$arch" == "arm64" ) ]]; then suffix="_aarch64.so"
    elif [[ "$os" == "Linux" ]]; then suffix=".so"
    else echo "Unsupported platform: $os/$arch"; exit 1; fi
    echo "Checking libraries for $os/$arch ..."
    missing=0
    for entry in {{ SDK_LIBS }}; do
        dir="${entry%%:*}"; base="${entry##*:}"; f="$dir/lib/${base}${suffix}"
        if [[ -f "$f" ]]; then echo "  ✓ $f"; else echo "  ✗ MISSING $f"; missing=1; fi
    done
    [[ $missing -eq 0 ]] && echo "All libraries present." || { echo "Some libraries are missing."; exit 1; }

# Install this platform's C/C++ library + headers into a prefix (default /usr/local; use ~/.local or sudo).
install prefix="/usr/local":
    #!/usr/bin/env bash
    set -euo pipefail
    os="$(uname -s)"; arch="$(uname -m)"
    if [[ "$os" == "Darwin" ]]; then suffix=".dylib"; ext=".dylib"
    elif [[ "$os" == "Linux" && ( "$arch" == "aarch64" || "$arch" == "arm64" ) ]]; then suffix="_aarch64.so"; ext=".so"
    elif [[ "$os" == "Linux" ]]; then suffix=".so"; ext=".so"
    else echo "Unsupported platform: $os/$arch"; exit 1; fi
    libdir="{{ prefix }}/lib"; incdir="{{ prefix }}/include"
    if ! mkdir -p "$libdir" "$incdir" 2>/dev/null || [[ ! -w "$libdir" ]]; then
        echo "Cannot write to {{ prefix }}. Re-run with sudo, or pass a writable prefix,"
        echo "e.g.  install ~/.local  (as 'just install …' here, or 'just sdk install …' from repo root)."
        exit 1
    fi
    for entry in {{ SDK_LIBS }}; do
        dir="${entry%%:*}"; base="${entry##*:}"; src="$dir/lib/${base}${suffix}"
        [[ -f "$src" ]] || { echo "  ✗ MISSING $src — run the 'check' recipe first"; exit 1; }
        cp "$src" "$libdir/${base}${ext}"          # install under the runtime name (drop _aarch64 tag)
        cp -R "$dir/cpp/include/." "$incdir/"
        echo "  ✓ ${base}${ext} + headers → {{ prefix }}"
    done
    [[ "$os" == "Linux" ]] && command -v ldconfig >/dev/null 2>&1 && ldconfig 2>/dev/null || true
    echo "Installed to {{ prefix }}. Add \"$libdir\" to your linker path if it isn't already."

# Install the Python SDK packages into your active environment (uv, else pip; run inside your venv).
install-python:
    #!/usr/bin/env bash
    set -euo pipefail
    # Prefers uv (the demos already use it); falls back to pip. Native libraries
    # load from <sdk>/lib/ in this tree — run `just install` too if you want them
    # on the system linker path.
    if command -v uv >/dev/null 2>&1; then pm=(uv pip install); else pm=(python3 -m pip install); fi
    echo "Installing Python SDKs with: ${pm[*]}"
    for entry in {{ SDK_LIBS }}; do
        dir="${entry%%:*}"
        [[ -f "$dir/python/pyproject.toml" ]] || { echo "  - skip $dir (no python package)"; continue; }
        "${pm[@]}" "./$dir/python"
        echo "  ✓ installed $dir/python"
    done
