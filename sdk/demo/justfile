# ProHand, ProGlove & ProWristCam SDK Demo - cdylib FFI approach
# Demos using the C FFI (dylib) bindings for hand, glove, and wrist camera

[group: 'modules']
mod python "python/justfile"
[group: 'modules']
mod cpp "cpp/justfile"

# Show all commands
default:
    @echo "================================================================"
    @echo "ProHand, ProGlove & ProWristCam SDK Demo - cdylib FFI"
    @echo "================================================================"
    @just --list
    @echo "================================================================"
    @echo "Run:  just sdk demo <group> <command>     (from the repo root)"
    @echo "      just demo <group> <command>         (from sdk/)"
    @echo "      just <group> <command>              (from sdk/demo/)"
    @echo "  <group> is 'python' or 'cpp'."
    @echo "================================================================"
    @echo "ProGlove (Glove) Demos:"
    @echo "  python test-glove              # Monitor tactile sensors"
    @echo "  python rerun-glove left|right  # Log raw + processed tactile to Rerun"
    @echo "  cpp test-glove                 # C++ tactile monitor"
    @echo "================================================================"
    @echo "ProWristCam Demos:"
    @echo "  python connect-wristcam left|right   # Test camera connection"
    @echo "  python test-wristcam left|right      # Monitor camera stream (terminal)"
    @echo "  python view-wristcam left|right      # Live GUI viewer (tkinter + Pillow)"
    @echo "  cpp connect-wristcam left|right      # C++ camera connection"
    @echo "  cpp test-wristcam left|right         # C++ camera monitor"
    @echo "================================================================"
