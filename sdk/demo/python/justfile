    fi

# Run test-ota demo: test-ota left|right --image <path.bin> OR test-ota --status-endpoint <endpoint> --image <path.bin>
test-ota +args:
    #!/usr/bin/env bash
    set -euo pipefail
    cd src
    ARGS=({{ args }})
    FIRST="${ARGS[0]:-}"
    REST="${ARGS[@]:1}"
    if [ "$FIRST" = "left" ]; then
        python3 -m proglove_demo.test_ota --status-endpoint "ipc:///tmp/proglove-left-status.ipc" $REST
