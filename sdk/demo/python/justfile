# ProHand, ProGlove & ProWristCam SDK Python Demo - cdylib FFI

default:
    @just --list

# Run connect demo (test IPC connection)
connect:
    cd src && python3 -m prohand_demo.connect

# Run ping demo (send ping commands)
ping *args:
    cd src && python3 -m prohand_demo.ping {{ args }}

# Show every value the SDK exposes (read-only dashboard, sends no commands)
show-all *args:
    cd src && python3 -m prohand_demo.show_all {{ args }}

# Run test_hand demo (test each joint individually)
test-hand *args:
    cd src && python3 -m prohand_demo.test_hand {{ args }}

# Run cyclic_motion demo (sine wave motion patterns)
cyclic-motion *args:
    cd src && python3 -m prohand_demo.cyclic_motion {{ args }}

# Run udcap for left hand with IPC defaults
udcap-left *args:
    cd src && python3 -m prohand_demo.udcap_ctrl --hand left {{ args }}

# Run udcap for right hand with IPC defaults
udcap-right *args:
    cd src && python3 -m prohand_demo.udcap_ctrl --hand right {{ args }}

# Run kapandji demo (opposition test - placeholder)
kapandji *args:
    cd src && python3 -m prohand_demo.kapandji {{ args }}

# Play predefined keyframe sequences (template, abduction, count, wave, rock-on, fist-wrist)
keyframe-motion *args:
    cd src && python3 -m prohand_demo.keyframe_motion {{ args }}

# Print the keyframes of a sequence without moving the hand
keyframe-list sequence="template":
    cd src && python3 -m prohand_demo.keyframe_motion --sequence {{ sequence }} --list

# Exercise every SDK command and report pass/fail coverage
command-matrix *args:
    cd src && python3 -m prohand_demo.command_matrix {{ args }}

# Debug streaming mode connectivity
debug-streaming *args:
    cd src && python3 -m prohand_demo.debug_streaming {{ args }}

# Needs the rerun extra: `uv pip install rerun-sdk` (or `uv sync --extra rerun`).
# Auto-starts the hand driver in a tmux session if none is running (--no-launch to attach instead).
# Log rotary/linear feedback + firmware target echo to Rerun while streaming a curl: rerun-hand [options]
rerun-hand *args:
    cd src && python3 -m prohand_demo.rerun_log {{ args }}

# Run connect-glove demo: connect-glove left|right [options] OR connect-glove --status-endpoint <endpoint>
connect-glove +args:
    #!/usr/bin/env bash
    set -euo pipefail
    cd src
    ARGS=({{ args }})
    FIRST="${ARGS[0]:-}"
    REST="${ARGS[@]:1}"
    if [ "$FIRST" = "left" ]; then
        python3 -m proglove_demo.connect --status-endpoint "ipc:///tmp/proglove-left-status.ipc" $REST
    elif [ "$FIRST" = "right" ]; then
        python3 -m proglove_demo.connect --status-endpoint "ipc:///tmp/proglove-right-status.ipc" $REST
    else
        python3 -m proglove_demo.connect {{ args }}
    fi

# Run test-glove demo: test-glove left|right [options] OR test-glove --status-endpoint <endpoint>
test-glove +args:
    #!/usr/bin/env bash
    set -euo pipefail
    cd src
    ARGS=({{ args }})
    FIRST="${ARGS[0]:-}"
    REST="${ARGS[@]:1}"
    if [ "$FIRST" = "left" ]; then
        python3 -m proglove_demo.test_glove --status-endpoint "ipc:///tmp/proglove-left-status.ipc" $REST
    elif [ "$FIRST" = "right" ]; then
        python3 -m proglove_demo.test_glove --status-endpoint "ipc:///tmp/proglove-right-status.ipc" $REST
    else
        python3 -m proglove_demo.test_glove {{ args }}
    fi

# Run filter-control demo: filter-control left|right [options] OR filter-control --status-endpoint <endpoint>
filter-control +args:
    #!/usr/bin/env bash
