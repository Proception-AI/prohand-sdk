    fi

# Needs the rerun extra: `uv pip install rerun-sdk numpy` (or `uv sync --extra rerun`).
# Auto-starts the glove driver in a tmux session if none is running (--no-launch to attach instead).
# Log raw + processed tactile to Rerun: rerun-glove [left|right] [options]
rerun-glove *args:
    #!/usr/bin/env bash
    set -euo pipefail
    cd src
    ARGS=({{ args }})
    FIRST="${ARGS[0]:-}"
    REST="${ARGS[@]:1}"
    if [ "$FIRST" = "left" ]; then
        python3 -m proglove_demo.rerun_log --endpoint "ipc:///tmp/proglove-left-status.ipc" $REST
    elif [ "$FIRST" = "right" ]; then
        python3 -m proglove_demo.rerun_log --endpoint "ipc:///tmp/proglove-right-status.ipc" $REST
    else
        python3 -m proglove_demo.rerun_log {{ args }}
    fi

